`;

document.head.appendChild(style);


/* ============================================================
   MENU
   ============================================================ */

const menu = document.createElement("div");

menu.id = "cl-custom-menu";

menu.innerHTML = `
<div class="title">CLUTCHER CUSTOM V9</div>

<div class="section">
<div class="section-title">Visuals</div>

<label>ESP
<input data-bool="esp" type="checkbox">
</label>

<label>Tracers
<input data-bool="tracers" type="checkbox">
</label>

<label>Chams
<input data-bool="chams" type="checkbox">
</label>

<label>Third Person
<input data-bool="thirdPerson" type="checkbox">
</label>

<label>Player Model
<input data-bool="playerModel" type="checkbox">
</label>

<label>Third Distance
<input data-range="thirdDistance" type="range" min="1.5" max="7" step=".1">
</label>

<label>Third Height
<input data-range="thirdHeight" type="range" min=".5" max="3" step=".05">
</label>
</div>


<div class="section">
<div class="section-title">Aim</div>

<label>Silent Aim
<input data-bool="silentAim" type="checkbox">
</label>

<label>Visibility Check
<input data-bool="wallCheck" type="checkbox">
</label>

<label>Wallbang
<input data-bool="wallbang" type="checkbox">
</label>

<label>Aim Head
<input data-bool="aimHead" type="checkbox">
</label>

<label>Aim FOV
<input data-range="aimFov" type="range" min="30" max="500" step="5">
</label>
</div>


<div class="section">
<div class="section-title">Movement</div>

<label>BHop
<input data-bool="bhop" type="checkbox">
</label>

<label>Fast BHop
<input data-bool="fastBhop" type="checkbox">
</label>

<label>Auto Strafe
<input data-bool="autoStrafe" type="checkbox">
</label>

<label>BHop Speed
<input data-range="bhopSpeed" type="range" min="7" max="30" step=".5">
</label>

<label>Fly
<input data-bool="fly" type="checkbox">
</label>

<label>Fly Speed
<input data-range="flySpeed" type="range" min="2" max="30" step=".5">
</label>
</div>


<div class="section">
<div class="section-title">Weapon</div>

<label>Rapid Fire
<input data-bool="rapidFire" type="checkbox">

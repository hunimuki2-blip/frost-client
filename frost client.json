(() => {
"use strict";

/* ============================================================
   CLUTCHER CUSTOM V9 — FULL
   ============================================================ */

window.__clutcherCustom?.destroy?.();

const game = window.game;

if (!game?.player || !game?.renderer) {
    console.error("[V9] game not ready");
    return;
}

const STORAGE = "__clutcher_custom_v9";

const defaults = {
    menu: true,

    // VISUALS
    esp: true,
    tracers: false,
    chams: false,

    // AIM
    silentAim: false,
    wallCheck: true,
    wallbang: false,
    aimHead: true,
    aimFov: 180,

    // MOVEMENT
    bhop: false,
    fastBhop: false,
    autoStrafe: true,
    bhopSpeed: 14,

    fly: false,
    flySpeed: 9,

    // WEAPON
    rapidFire: false,
    infiniteAmmo: false,
    infiniteMoney: true,
    noRecoil: false,

    // PLAYER
    godMode: false,
    noFlash: false,

    // THIRD PERSON
    thirdPerson: false,
    playerModel: true,
    spinbot: false,

    thirdDistance: 3.4,
    thirdHeight: 1.65,
    spinSpeed: 14,

    binds: {
        menu: "NumpadAdd",
        fly: "KeyG",
        thirdPerson: "KeyV",
        playerModel: "KeyB",
        spinbot: "KeyX",
        silentAim: "KeyC",
        wallbang: "KeyZ",
        bhop: "KeyH",
        esp: "KeyK",
        chams: "KeyL",
        rapidFire: "KeyR"
    }
};


/* ============================================================
   SETTINGS
   ============================================================ */

let saved = {};

try {
    saved = JSON.parse(
        localStorage.getItem(STORAGE) || "{}"
    );
} catch {}

const state = Object.assign(
    {},
    defaults,
    saved
);

state.binds = Object.assign(
    {},
    defaults.binds,
    saved.binds || {}
);

function save() {
    try {
        localStorage.setItem(
            STORAGE,
            JSON.stringify(state)
        );
    } catch {}
}


/* ============================================================
   STYLE
   ============================================================ */

const style = document.createElement("style");

style.textContent = `
